<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PointDeviation</AssemblyName>
    <RootNamespace>PointDeviation</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <!-- il motore delle nuvole scrive i punti direttamente nel buffer di Revit -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Cartella di installazione di Revit 2024: modificala se diversa -->
    <RevitDir>C:\Program Files\Autodesk\Revit 2024\</RevitDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Icone della barra multifunzione, incorporate nella DLL -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="Resources\*.png">
      <LogicalName>PointDeviation.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Voce 202: la libreria nativa si compila da sola prima del plugin, solo se PdRender.cpp e' piu' recente della
       DLL (altrimenti il passo si salta). Errori del compilatore C++ nella finestra Output di Visual Studio. -->
  <Target Name="BuildNative" BeforeTargets="Build" Inputs="$(MSBuildProjectDirectory)\Native\PdRender.cpp;$(MSBuildProjectDirectory)\Native\build.bat" Outputs="$(MSBuildProjectDirectory)\Native\PdRender.dll">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\build.bat&quot; nopause" />
  </Target>

  <!-- Copia DLL e manifest nella cartella Addins di Revit 2024 (chiudi Revit prima di compilare) -->
  <Target Name="DeployToRevit" AfterTargets="Build">
    <PropertyGroup>
      <AddinsDir>$(AppData)\Autodesk\Revit\Addins\2024\</AddinsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AddinsDir)PointDeviation\" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\PointDeviation.addin" DestinationFolder="$(AddinsDir)" />
    <!-- libreria nativa sperimentale (voce 180), compilata dal passo BuildNative qui sopra -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Native\PdRender.dll" DestinationFolder="$(AddinsDir)PointDeviation\" Condition="Exists('$(MSBuildProjectDirectory)\Native\PdRender.dll')" />
  </Target>

</Project>
